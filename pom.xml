<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>com.aegisflow</groupId>
    <artifactId>aegisflow-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>AegisFlow Fraud Detection Platform</name>
    <description>Real-Time Fraud Detection and Dynamic Risk Scoring Engine</description>

    <modules>
        <module>aegis-common</module>
        <module>transaction-service</module>
        <module>fraud-engine-service</module>
        <module>investigation-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <redisson.version>3.41.0</redisson.version>
        <aegisflow.version>1.0.0</aegisflow.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.aegisflow</groupId>
                <artifactId>aegis-common</artifactId>
                <version>${aegisflow.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>